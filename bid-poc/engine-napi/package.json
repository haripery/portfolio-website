{
  "name": "engine-napi",
  "version": "0.1.0",
  "private": true,
  "description": "napi-rs wrapper exposing engine-core to Node.js (architecture A)",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "engine-napi",
    "targets": [
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.11.1"
  }
}
